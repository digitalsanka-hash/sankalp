# SankaPage — Environment Variables
# Ganti nama file ini menjadi ".env.local" lalu isi nilainya.
#
# WAJIB: tanpa dua nilai Supabase di bawah, aplikasi TERKUNCI total —
# kode akses tidak bisa diperiksa, jadi galeri & editor tidak bisa dibuka.

# URL project Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik anon (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Pengiriman kode akses lewat email (opsional, dipakai /api/send-code) ----

# API key Resend (resend.com > API Keys)
RESEND_API_KEY=

# Kode admin untuk mengunci endpoint /api/send-code.
# BIARKAN TERISI. Kalau dikosongkan, pemeriksaan dilewati dan siapa pun
# bisa memanggil endpoint pengirim email itu.
ADMIN_CODE=

# Alamat aplikasi, dipakai di tautan dalam email (contoh: https://www.sankapage.com)
APP_URL=

# Pengirim email (contoh: SankaPage <akses@sankapage.com>)
MAIL_FROM=

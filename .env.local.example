# SankaLP — Environment Variables
# Fase 1: BOLEH DIKOSONGKAN. Aplikasi jalan pakai data lokal (JSON) tanpa Supabase.
# Fase 2: isi dua nilai di bawah dengan kredensial project Supabase Anda,
# lalu ganti nama file ini menjadi ".env.local".

# URL project Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik anon (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
